{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cert Study Question",
  "description": "Schema for a single question in the app's flat exam JSON format.",
  "type": "object",
  "required": [
    "id",
    "domain",
    "domainName",
    "question"
  ],
  "properties": {
    "id": {
      "description": "Unique integer identifier within the exam file.",
      "type": "integer"
    },
    "domain": {
      "description": "Domain number (matches exam.domains[].number).",
      "type": "integer",
      "minimum": 1
    },
    "domainName": {
      "description": "Human-readable domain name.",
      "type": "string"
    },
    "topic": {
      "description": "Optional sub-topic label shown in the quiz UI.",
      "type": "string"
    },
    "question": {
      "description": "Full question text. Use \\n to separate a scenario preamble from the question stem.",
      "type": "string",
      "minLength": 10
    },
    "options": {
      "description": "Answer choices keyed A–D.",
      "type": "object",
      "required": [
        "A",
        "B",
        "C",
        "D"
      ],
      "properties": {
        "A": {
          "type": "string"
        },
        "B": {
          "type": "string"
        },
        "C": {
          "type": "string"
        },
        "D": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "answer": {
      "description": "Key of the correct option.",
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "rationale": {
      "description": "Overall explanation shown when optionRationales is absent.",
      "type": "string"
    },
    "optionRationales": {
      "description": "Per-option explanation (shown in the full explanation panel).",
      "type": "object",
      "properties": {
        "A": {
          "type": "string"
        },
        "B": {
          "type": "string"
        },
        "C": {
          "type": "string"
        },
        "D": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "references": {
      "description": "Optional list of supporting documentation links rendered under the answer in the UI.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "additionalProperties": false
      }
    },
    "objectiveId": {
      "type": "string",
      "description": "Official SC-500 skill bullet the question assesses"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "foundational",
        "intermediate",
        "advanced"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "type": {
      "type": "string",
      "enum": [
        "choice",
        "hotspot"
      ],
      "default": "choice",
      "description": "Absent means multiple choice."
    },
    "image": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+/images/[A-Za-z0-9_-]+\\.png$",
      "description": "Relative path from the data/exams/ directory to a PNG screenshot."
    },
    "hotspots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "x",
          "y",
          "w",
          "h",
          "label"
        ],
        "properties": {
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "w": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "h": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "tolerance": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "default": 1
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "hotspot"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "image",
          "hotspots"
        ]
      },
      "else": {
        "required": [
          "options",
          "answer"
        ]
      }
    }
  ]
}
